# ─────────────────────────────────────────────────────
# OpenATC — Environment Configuration
# ─────────────────────────────────────────────────────
# Copy this file to .env and customize:
#   cp .env.example .env
#
# All settings have safe defaults for local development.
# ─────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────
POSTGRES_DB=ai_atc
POSTGRES_USER=atc_admin
POSTGRES_PASSWORD=atc_password_secret

# ── Infrastructure ──────────────────────────────────
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
WHISPER_URL=http://whisper-stt:9000

# ── LLM (Ollama) ────────────────────────────────────
# Set OLLAMA_URL to your Ollama host IP.
# On macOS with local Ollama: http://host.docker.internal:11434
# On Linux with local Ollama: http://172.17.0.1:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:30b

# ── API Security ────────────────────────────────────
ATC_API_TOKEN=atc_test_token_1234567890abcdef

# ── Auth (JWT) ──────────────────────────────────────
AUTH_JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=atc_admin_secret

# ── CORS ────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:80

# ── World Engine ────────────────────────────────────
WORLD_TICK_HZ=10.0
WORLD_CONFLICT_DETECTION_ENABLED=true
WORLD_LATERAL_SEPARATION_NM=5.0
WORLD_VERTICAL_SEPARATION_FT=1000.0
WORLD_TERMINAL_LATERAL_SEPARATION_NM=3.0
WORLD_TRAJECTORY_LOOKAHEAD_S=120.0

# ── Logging ─────────────────────────────────────────
LOG_LEVEL=info
