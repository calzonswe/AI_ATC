FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app
COPY pyproject.toml ./
COPY services/controller services/controller
COPY packages/common packages/common
COPY packages/protocol packages/protocol
RUN uv sync --no-dev

FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/services/controller/src /app/services/controller/src
COPY --from=builder /app/packages/common/src /app/packages/common/src
COPY --from=builder /app/packages/protocol/src /app/packages/protocol/src

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/services/controller/src:/app/packages/common/src:/app/packages/protocol/src"

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8100/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8100"]
